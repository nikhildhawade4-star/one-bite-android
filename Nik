
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f36b21">
<title>One Bite POS</title>
<link rel="manifest" href="./pos.webmanifest">
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f7f6f4;color:#292929}
header{background:#f36b21;color:white;padding:18px;display:flex;justify-content:space-between;align-items:center}
header h2{margin:0;font-size:22px}
main{max-width:1100px;margin:auto;padding:16px}
.panel{background:white;border-radius:12px;padding:16px;margin-bottom:16px;box-shadow:0 2px 8px #0000000d}
h3{margin:0 0 14px}
input,select,button{font:inherit;padding:11px;border-radius:8px;border:1px solid #ddd}
button{background:#f36b21;color:white;border:0;cursor:pointer;font-weight:bold}
button.secondary{background:#555}
button.danger{background:#c62828}
button:disabled{opacity:.5}
.layout{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}
.menu{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:10px}
.item{border:1px solid #eee;border-radius:10px;padding:12px}
.item strong{display:block;margin-bottom:8px}
.item button{width:100%}
.line{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:10px 0}
.total{font-size:22px;font-weight:bold}
input[type=number]{width:85px}
.actions{display:flex;gap:8px;flex-wrap:wrap}
small{color:#777}
@media(max-width:700px){.layout{grid-template-columns:1fr}header h2{font-size:19px}}
</style>
</head>
<body>
<header>
<h2>🍔 One Bite POS</h2>
<div id="today"></div>
</header>
<main>
<section class="panel">
<h3>Billing Counter</h3>
<div class="actions">
<button onclick="newBill()">New Bill</button>
<button class="secondary" onclick="showHistory()">Bill History</button>
<button class="secondary" onclick="manageMenu()">Manage Menu</button>
</div>
<p><small>One Bite – Take a Bite, Feel the Happiness!</small></p>
</section>
<div class="layout">
<section class="panel">
<h3>Menu</h3>
<input id="search" placeholder="Search menu..." oninput="renderMenu()" style="width:100%;margin-bottom:12px">
<div id="menu" class="menu"></div>
</section>
<section class="panel">
<h3>Current Bill</h3>
<div class="line">
<label>Order type</label>
<select id="orderType">
<option>Dine-in</option>
<option>Takeaway / Parcel</option>
</select>
</div>
<div class="line">
<label>Table / Order no.</label>
<input id="tableNo" placeholder="e.g. Table 1">
</div>
<div id="cart"></div>
<hr>
<div class="line">
<label>Discount (₹)</label>
<input id="discount" type="number" min="0" value="0" oninput="renderCart()">
</div>
<div class="line"><span>Subtotal</span><span id="subtotal">₹0</span></div>
<div class="line total"><span>Total</span><span id="total">₹0</span></div>
<div class="line">
<label>Payment</label>
<select id="payment">
<option>Cash</option>
<option>UPI</option>
<option>Card</option>
</select>
</div>
<div class="actions">
<button onclick="checkout()">Complete Payment</button>
<button class="secondary" onclick="clearBill()">Clear Bill</button>
</div>
</section>
</div>
<div id="extra"></div>
</main>
  
<script>
const defaultMenu=[
{name:"Veg Sandwich",price:60},
{name:"Cheese Sandwich",price:90},
{name:"Grilled Sandwich",price:80},
{name:"Veg Pizza",price:120},
{name:"Cheese Pizza",price:150},
{name:"French Fries",price:70},
{name:"Burger",price:80},
{name:"Vada Pav",price:20},
{name:"Tea",price:15},
{name:"Coffee",price:25}
];

let menuItems=JSON.parse(localStorage.getItem("ob_menu")||"null")||defaultMenu;
let cart=[];
let bills=JSON.parse(localStorage.getItem("ob_bills")||"[]");

function money(n){return "₹"+Number(n).toFixed(2)}
function saveMenu(){localStorage.setItem("ob_menu",JSON.stringify(menuItems))}
function saveBills(){localStorage.setItem("ob_bills",JSON.stringify(bills))}

function renderMenu(){
 const q=document.getElementById("search").value.toLowerCase();
 document.getElementById("menu").innerHTML=menuItems
 .filter(x=>x.name.toLowerCase().includes(q))
 .map((x,i)=>`<div class="item">
 <strong>${x.name}</strong>
 <div class="line">${money(x.price)}</div>
 <button onclick="addItem(${i})">Add to Bill</button>
 </div>`).join("");
}

function addItem(i){
 const item=menuItems[i];
 const found=cart.find(x=>x.name===item.name);
 if(found)found.qty++;
 else cart.push({...item,qty:1});
 renderCart();
}

function renderCart(){
 const el=document.getElementById("cart");
 if(!cart.length)el.innerHTML="<small>No items added yet.</small>";
 else el.innerHTML=cart.map((x,i)=>`
 <div class="line">
 <div><strong>${x.name}</strong><br><small>${money(x.price)} each</small></div>
 <div class="actions">
 <button onclick="changeQty(${i},-1)">−</button>
 <span>${x.qty}</span>
 <button onclick="changeQty(${i},1)">+</button>
 <button class="danger" onclick="removeItem(${i})">×</button>
 </div>
 </div>`).join("");

 const sub=cart.reduce((s,x)=>s+x.price*x.qty,0);
 const discount=Math.max(0,Math.min(sub,Number(document.getElementById("discount").value)||0));
 document.getElementById("subtotal").textContent=money(sub);
 document.getElementById("total").textContent=money(sub-discount);
}

function changeQty(i,n){
 cart[i].qty+=n;
 if(cart[i].qty<=0)cart.splice(i,1);
 renderCart();
}
function removeItem(i){cart.splice(i,1);renderCart()}
function clearBill(){
 if(confirm("Clear this bill?")){
 cart=[];document.getElementById("discount").value=0;renderCart();
 }
}
function newBill(){clearBill();document.getElementById("tableNo").value=""}

function checkout(){
 if(!cart.length){alert("Please add items first.");return}
 const subtotal=cart.reduce((s,x)=>s+x.price*x.qty,0);
 const discount=Math.max(0,Math.min(subtotal,Number(document.getElementById("discount").value)||0));
 const bill={
 id:Date.now(),
 date:new Date().toLocaleString("en-IN"),
 type:document.getElementById("orderType").value,
 table:document.getElementById("tableNo").value,
 items:cart.map(x=>({...x})),
 subtotal,discount,total:subtotal-discount,
 payment:document.getElementById("payment").value
 };
 bills.unshift(bill);
 saveBills();
 alert("Payment completed!\nTotal: "+money(bill.total));
 printBill(bill);
 cart=[];
 document.getElementById("discount").value=0;
 document.getElementById("tableNo").value="";
 renderCart();
}
</script>

<script>
function printBill(b){
 const w=window.open("","_blank","width=400,height=650");
 if(!w){alert("Please allow pop-ups to print the receipt.");return}
 w.document.write(`
 <html><head><title>One Bite Receipt</title>
 <style>
 body{font-family:Arial;padding:15px}
 h2,p{text-align:center}
 hr{border-top:1px dashed #777}
 .row{display:flex;justify-content:space-between;margin:9px 0}
 </style></head><body>
 <h2>ONE BITE</h2>
 <p>Take a Bite, Feel the Happiness!</p>
 <hr>
 <p>${b.date}</p>
 <p>${b.type} ${b.table||""}</p>
 <hr>
 ${b.items.map(x=>`<div class="row"><span>${x.name} x ${x.qty}</span><span>${money(x.price*x.qty)}</span></div>`).join("")}
 <hr>
 <div class="row"><b>Subtotal</b><b>${money(b.subtotal)}</b></div>
 <div class="row"><span>Discount</span><span>${money(b.discount)}</span></div>
 <div class="row"><h3>Total</h3><h3>${money(b.total)}</h3></div>
 <p>Payment: ${b.payment}</p>
 <hr><p>Thank you! Visit again ❤️</p>
 <script>window.onload=()=>window.print();<\/script>
 </body></html>`);
 w.document.close();
}

function showHistory(){
 const el=document.getElementById("extra");
 el.innerHTML=`<section class="panel">
 <h3>Bill History</h3>
 ${bills.length?bills.map(b=>`
 <div class="line">
 <div><strong>${money(b.total)}</strong><br><small>${b.date} · ${b.type} · ${b.payment}</small></div>
 <button onclick="printBill(bills.find(x=>x.id===${b.id}))">Print</button>
 </div>`).join(""):"<small>No bills yet.</small>"}
 <p><button class="secondary" onclick="document.getElementById('extra').innerHTML=''">Close</button></p>
 </section>`;
}

function manageMenu(){
 const el=document.getElementById("extra");
 el.innerHTML=`<section class="panel">
 <h3>Manage Menu</h3>
 <input id="newName" placeholder="Item name">
 <input id="newPrice" type="number" min="0" placeholder="Price ₹">
 <button onclick="addMenuItem()">Add Item</button>
 <hr>
 <div id="menuManage"></div>
 <button class="secondary" onclick="document.getElementById('extra').innerHTML=''">Close</button>
 </section>`;
 renderManageMenu();
}

function addMenuItem(){
 const name=document.getElementById("newName").value.trim();
 const price=Number(document.getElementById("newPrice").value);
 if(!name||!Number.isFinite(price)||price<=0){
 alert("Enter a valid item name and price.");return;
 }
 menuItems.push({name,price});
 saveMenu();
 renderMenu();
 document.getElementById("newName").value="";
 document.getElementById("newPrice").value="";
 renderManageMenu();
}

function renderManageMenu(){
 const el=document.getElementById("menuManage");
 if(!el)return;
 el.innerHTML=menuItems.map((x,i)=>`
 <div class="line">
 <span>${x.name} — ${money(x.price)}</span>
 <div class="actions">
 <button class="secondary" onclick="editMenuItem(${i})">Edit</button>
 <button class="danger" onclick="deleteMenuItem(${i})">Delete</button>
 </div>
 </div>`).join("");
}

function editMenuItem(i){
 const name=prompt("Item name:",menuItems[i].name);
 if(name===null)return;
 const price=prompt("Price:",menuItems[i].price);
 if(price===null)return;
 if(!name.trim()||!Number.isFinite(Number(price))||Number(price)<=0){
 alert("Invalid name or price.");return;
 }
 menuItems[i]={name:name.trim(),price:Number(price)};
 saveMenu();renderMenu();renderManageMenu();
}

function deleteMenuItem(i){
 if(confirm("Delete "+menuItems[i].name+"?")){
 menuItems.splice(i,1);
 saveMenu();renderMenu();renderManageMenu();
 }
}

document.getElementById("today").textContent=
 new Date().toLocaleDateString("en-IN",{
 weekday:"short",day:"numeric",month:"short",year:"numeric"
 });

renderMenu();
renderCart();

if("serviceWorker" in navigator){
 window.addEventListener("load",()=>{
 navigator.serviceWorker.register("./pos-sw.js")
 .catch(err=>console.error("Service worker error:",err));
 });
}
</script>
</body>
</html>


