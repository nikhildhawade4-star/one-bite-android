<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f36b21"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><link rel="manifest" href="./pos.webmanifest">
<title>One Bite POS</title>
<style>
:root{--orange:#f36b21;--orange2:#ff8a42;--ink:#252321;--muted:#85817d;--line:#eee9e5;--bg:#f7f6f4;--green:#16834b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}button,input,select{font:inherit}button{cursor:pointer}.top{height:66px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}.brand{display:flex;align-items:center;gap:10px;font-weight:850;font-size:20px}.logo{background:linear-gradient(135deg,var(--orange),var(--orange2));color:white;width:39px;height:39px;border-radius:13px;display:grid;place-items:center;font-weight:900}.brand small{display:block;font-size:10px;letter-spacing:1.4px;color:var(--muted);font-weight:700}.top-right{font-size:12px;color:var(--muted)}main{max-width:1200px;margin:auto;padding:20px}.welcome{display:flex;justify-content:space-between;align-items:end;margin:5px 0 18px;gap:12px}.welcome h1{margin:0;font-size:25px}.welcome p{margin:5px 0 0;color:var(--muted);font-size:13px}.date{background:#fff;border:1px solid var(--line);padding:9px 12px;border-radius:12px;font-size:12px;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}.stat{background:#fff;padding:14px;border:1px solid var(--line);border-radius:16px}.stat span{font-size:11px;color:var(--muted)}.stat b{display:block;font-size:21px;margin-top:5px}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(290px,.85fr);gap:16px;align-items:start}.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;min-width:0}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:13px}.panel h2{font-size:17px;margin:0}.search{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:11px;outline:none;margin-bottom:12px}.search:focus,input:focus,select:focus{border-color:var(--orange)}.categories{display:flex;gap:7px;overflow:auto;padding-bottom:10px;margin-bottom:5px}.cat{white-space:nowrap;border:1px solid var(--line);background:white;padding:8px 12px;border-radius:30px;font-size:12px;color:#625d58}.cat.active{background:var(--orange);border-color:var(--orange);color:white}.products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.product{border:1px solid var(--line);border-radius:14px;padding:12px;text-align:left;background:#fff;min-height:137px;display:flex;flex-direction:column}.product:active{transform:scale(.98)}.emoji{font-size:26px;margin-bottom:8px}.product strong{font-size:12px;line-height:1.35}.product small{font-size:10px;color:var(--muted);margin-top:3px}.product .bottom{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:10px}.price{font-size:13px;font-weight:800}.add{background:#fff2e9;color:#d95712;border:0;border-radius:8px;padding:6px 9px;font-size:11px;font-weight:800}.cart-panel{position:sticky;top:82px}.cart-empty{text-align:center;padding:30px 8px;color:var(--muted);font-size:13px}.cart-row{display:grid;grid-template-columns:1fr auto auto;gap:9px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}.cart-row strong{font-size:12px}.cart-row small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.qty{display:flex;align-items:center;gap:8px}.qty button{width:25px;height:25px;border:1px solid var(--line);background:#fff;border-radius:7px}.line-total{font-size:12px;font-weight:800;min-width:48px;text-align:right}.field{margin-top:12px}.field label{display:block;font-size:11px;font-weight:700;color:#625d58;margin-bottom:5px}.field input,.field select{width:100%;padding:10px;border:1px solid var(--line);border-radius:9px;background:white;outline:none;font-size:13px}.two{display:grid;grid-template-columns:1fr 1fr;gap:9px}.totals{margin-top:14px;border-top:1px dashed #ded8d2;padding-top:12px}.total-line{display:flex;justify-content:space-between;font-size:12px;color:#6f6963;margin:7px 0}.total-line.grand{font-size:18px;color:var(--ink);font-weight:900;margin-top:12px}.primary{width:100%;border:0;background:linear-gradient(135deg,var(--orange),var(--orange2));color:white;border-radius:11px;padding:13px;font-weight:850;margin-top:13px;box-shadow:0 5px 13px #f36b212b}.secondary{border:1px solid var(--line);background:white;padding:9px 11px;border-radius:9px;font-size:11px;font-weight:700}.hint{font-size:10px;color:var(--muted);line-height:1.5;margin:10px 0 0}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#272421;color:#fff;padding:11px 16px;border-radius:10px;font-size:12px;z-index:20;display:none}.history{margin-top:16px}.history-list{font-size:12px;color:var(--muted);line-height:1.8}.history-item{padding:9px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:10px}.manage-panel{margin-bottom:16px}.menu-form{display:grid;grid-template-columns:1.2fr 1fr .7fr .6fr auto;gap:8px;align-items:end}.menu-form input,.menu-form select{width:100%;padding:10px;border:1px solid var(--line);border-radius:9px;background:white;font-size:13px}.menu-list{margin-top:12px}.menu-row{display:grid;grid-template-columns:1fr auto auto auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}.menu-row small{display:block;color:var(--muted);font-size:11px}.menu-actions{display:flex;gap:6px}.danger{border:1px solid #f1c9c2;color:#b42318;background:#fff7f5;padding:8px 10px;border-radius:8px;font-size:11px;font-weight:700}.menu-editor{display:none}.menu-editor.open{display:block}.stock-toggle{font-size:11px;color:var(--green)}@media(max-width:650px){.menu-form{grid-template-columns:1fr 1fr}.menu-form button{grid-column:span 2}.menu-row{grid-template-columns:1fr auto}.menu-row .menu-actions{grid-column:1/-1}.menu-row .menu-price{grid-column:2;grid-row:1}}.history-item b{color:var(--ink)}
@media(max-width:800px){main{padding:14px}.layout{grid-template-columns:1fr}.cart-panel{position:static}.products{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{gap:8px}.stat{padding:11px}.stat b{font-size:18px}.welcome h1{font-size:22px}.top-right{display:none}}@media(min-width:801px){.products{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style></head>
<body>
<header class="top"><div class="brand"><div class="logo">OB</div><div>One Bite<small>RESTAURANT POS</small></div></div><div class="top-right">● Counter billing&nbsp; · &nbsp;Owner workspace</div></header>
<main>
<section class="welcome"><div><h1>Billing Counter</h1><p>Take orders, collect payment and create customer bills.</p></div><div class="date" id="today"></div></section>
<section class="stats"><div class="stat"><span>Today's bills</span><b id="billCount">0</b></div><div class="stat"><span>Today's sales</span><b id="todaySales">₹0</b></div><div class="stat"><span>Current cart</span><b id="cartCount">0 items</b></div></section>
<div class="layout"><section class="panel"><div class="panel-head"><h2>Choose items</h2><button class="secondary" id="manageMenuBtn">Manage menu</button></div><section class="panel manage-panel menu-editor" id="menuEditor" style="padding:13px;margin-bottom:14px">
<div class="panel-head"><h2>Menu management</h2><button class="secondary" id="closeMenuEditor">Close</button></div>
<p class="hint">Add, edit, change prices or mark items unavailable. Changes are saved on this device for now.</p>
<form id="menuForm" class="menu-form">
<div><label for="menuName">Item name</label><input id="menuName" required maxlength="50" placeholder="e.g. Paneer Sandwich"></div>
<div><label for="menuCategory">Category</label><input id="menuCategory" required maxlength="30" placeholder="e.g. Sandwiches" list="menuCategories"><datalist id="menuCategories"></datalist></div>
<div><label for="menuPrice">Price (₹)</label><input id="menuPrice" type="number" min="0" step="1" required placeholder="100"></div>
<div><label for="menuEmoji">Icon</label><input id="menuEmoji" maxlength="4" value="🍽️"></div>
<button class="primary" id="saveMenuItem" type="submit" style="margin:0">Add item</button>
</form><div class="menu-list" id="menuList"></div>
</section>
<input id="search" class="search" placeholder="Search food items…"><nav class="categories" id="categories"></nav><div class="products" id="products"></div></section>
<aside><section class="panel cart-panel"><div class="panel-head"><h2>Current bill</h2><button class="secondary" id="clearCart">Clear</button></div><div id="cartItems" class="cart-empty">Your bill is empty.<br>Tap an item to add it.</div>
<div class="field"><label for="customer">Customer name (optional)</label><input id="customer" placeholder="Walk-in customer"></div>
<div class="two"><div class="field"><label for="discount">Discount (₹)</label><input id="discount" type="number" min="0" value="0" inputmode="decimal"></div><div class="field"><label for="payment">Payment method</label><select id="payment"><option>Cash</option><option>UPI</option><option>Card</option></select></div></div>
<div class="totals"><div class="total-line"><span>Subtotal</span><b id="subtotal">₹0</b></div><div class="total-line"><span>Discount</span><b id="discountText">− ₹0</b></div><div class="total-line grand"><span>Total</span><span id="grandTotal">₹0</span></div></div>
<button class="primary" id="complete">Complete bill &amp; print</button><p class="hint">This first version saves bills on this device and opens the print dialog. Bluetooth thermal printing and secure cloud sync will be connected in later steps.</p></section>
<section class="panel history"><div class="panel-head"><h2>Recent bills</h2><button class="secondary" id="refresh">Refresh</button></div><div id="historyList" class="history-list">No bills created yet.</div></section></aside></div>
</main><div class="toast" id="toast"></div>
<script>
const defaultMenu=[
{id:'s1',cat:'Sandwiches',name:'Classic Veg Sandwich',price:70,emoji:'🥪'},{id:'s2',cat:'Sandwiches',name:'Masala Veg Sandwich',price:80,emoji:'🥪'},{id:'s3',cat:'Sandwiches',name:'Cheese Veg Sandwich',price:90,emoji:'🧀'},{id:'s4',cat:'Sandwiches',name:'Grilled Veg Sandwich',price:100,emoji:'🥪'},{id:'s5',cat:'Sandwiches',name:'Tandoori Veg Sandwich',price:110,emoji:'🔥'},{id:'s6',cat:'Sandwiches',name:'Corn & Cheese Sandwich',price:120,emoji:'🌽'},{id:'s7',cat:'Sandwiches',name:'Paneer Tikka Sandwich',price:130,emoji:'🧀'},
{id:'p1',cat:'Pizzas',name:'Margarita Pizza',price:130,emoji:'🍕'},{id:'p2',cat:'Pizzas',name:'Sweet Corn Pizza',price:140,emoji:'🌽'},{id:'p3',cat:'Pizzas',name:'Onion Pizza',price:140,emoji:'🧅'},{id:'p4',cat:'Pizzas',name:'Paneer Pizza',price:170,emoji:'🍕'},{id:'p5',cat:'Pizzas',name:'Mix Veg Pizza',price:170,emoji:'🍕'},
{id:'x1',cat:'Sides',name:'French Fries',price:80,emoji:'🍟'},{id:'x2',cat:'Sides',name:'Peri Peri Fries',price:90,emoji:'🍟'},{id:'x3',cat:'Sides',name:'Cheese Fries',price:110,emoji:'🧀'},{id:'x4',cat:'Sides',name:'Extra Cheese',price:20,emoji:'🧀'},{id:'x5',cat:'Sides',name:'Extra Sauce',price:15,emoji:'🥫'},
{id:'d1',cat:'Drinks',name:'Masala Chai',price:15,emoji:'☕'},{id:'d2',cat:'Drinks',name:'Cold Coffee',price:60,emoji:'🥤'},{id:'d3',cat:'Drinks',name:'Milkshake',price:70,emoji:'🥤'},{id:'d4',cat:'Drinks',name:'Fresh Lime Soda',price:40,emoji:'🍋'}];
let menu=JSON.parse(localStorage.getItem('onebite_pos_menu')||'null')||defaultMenu;
const saveMenu=()=>localStorage.setItem('onebite_pos_menu',JSON.stringify(menu));
let editingMenuId=null;
const cart=new Map();let category='All';const $=id=>document.getElementById(id);const money=n=>'₹'+Number(n).toFixed(0);const getBills=()=>JSON.parse(localStorage.getItem('onebite_pos_bills')||'[]');
function toast(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',2200)}
function renderCategories(){const cats=['All',...new Set(menu.map(x=>x.cat))];$('categories').innerHTML=cats.map(c=>`<button class="cat ${c===category?'active':''}" data-cat="${c}">${c}</button>`).join('')}
function renderProducts(){const q=$('search').value.toLowerCase();const list=menu.filter(x=>x.available!==false&&(category==='All'||x.cat===category)&&x.name.toLowerCase().includes(q));$('products').innerHTML=list.map(x=>`<button class="product" data-add="${x.id}"><span class="emoji">${x.emoji}</span><strong>${x.name}</strong><small>${x.cat}</small><span class="bottom"><span class="price">${money(x.price)}</span><span class="add">+ Add</span></span></button>`).join('')||'<p style="color:#888;font-size:12px">No items found.</p>'}
function renderMenuEditor(){
 const cats=[...new Set(menu.map(x=>x.cat))];$('menuCategories').innerHTML=cats.map(c=>`<option value="${c.replace(/&/g,'&amp;').replace(/</g,'&lt;')}"></option>`).join('');
 $('menuList').innerHTML=menu.map(x=>`<div class="menu-row"><div><b>${x.emoji||'🍽️'} ${x.name}</b><small>${x.cat} · ${x.available===false?'Unavailable':'Available'}</small></div><b class="menu-price">${money(x.price)}</b><div class="menu-actions"><button class="secondary" data-edit-menu="${x.id}">Edit</button><button class="secondary" data-stock-menu="${x.id}">${x.available===false?'Enable':'Disable'}</button><button class="danger" data-delete-menu="${x.id}">Delete</button></div></div>`).join('')||'<p class="hint">No menu items yet. Add your first item above.</p>';
}
function resetMenuForm(){editingMenuId=null;$('menuForm').reset();$('menuEmoji').value='🍽️';$('saveMenuItem').textContent='Add item'}
$('manageMenuBtn').onclick=()=>{$('menuEditor').classList.add('open');renderMenuEditor()};
$('closeMenuEditor').onclick=()=>$('menuEditor').classList.remove('open');
$('menuForm').addEventListener('submit',e=>{e.preventDefault();const name=$('menuName').value.trim(),cat=$('menuCategory').value.trim(),price=Number($('menuPrice').value),emoji=$('menuEmoji').value.trim()||'🍽️';if(!name||!cat||!Number.isFinite(price)||price<0){toast('Enter a valid name, category and price');return}if(editingMenuId){const item=menu.find(x=>x.id===editingMenuId);if(item)Object.assign(item,{name,cat,price,emoji})}else{menu.push({id:'m'+Date.now(),name,cat,price,emoji,available:true})}saveMenu();resetMenuForm();renderMenuEditor();renderCategories();renderProducts();toast('Menu saved on this device')});
$('menuList').addEventListener('click',e=>{const edit=e.target.closest('[data-edit-menu]'),stock=e.target.closest('[data-stock-menu]'),del=e.target.closest('[data-delete-menu]');if(edit){const x=menu.find(m=>m.id===edit.dataset.editMenu);if(!x)return;editingMenuId=x.id;$('menuName').value=x.name;$('menuCategory').value=x.cat;$('menuPrice').value=x.price;$('menuEmoji').value=x.emoji||'🍽️';$('saveMenuItem').textContent='Save changes';$('menuName').focus()}else if(stock){const x=menu.find(m=>m.id===stock.dataset.stockMenu);if(x){x.available=x.available===false?true:false;saveMenu();renderMenuEditor();renderProducts();renderCategories();toast('Availability updated')}}else if(del){const x=menu.find(m=>m.id===del.dataset.deleteMenu);if(x&&confirm(`Delete ${x.name} from the menu?`)){menu=menu.filter(m=>m.id!==x.id);saveMenu();renderMenuEditor();renderProducts();renderCategories();toast('Menu item deleted')}}});
function renderCart(){const rows=[...cart.entries()];const count=rows.reduce((a,[,q])=>a+q,0);$('cartCount').textContent=count+' items';if(!rows.length)$('cartItems').className='cart-empty',$('cartItems').innerHTML='Your bill is empty.<br>Tap an item to add it.';else{$('cartItems').className='';$('cartItems').innerHTML=rows.map(([id,q])=>{const x=menu.find(m=>m.id===id);return `<div class="cart-row"><div><strong>${x.name}</strong><small>${money(x.price)} each</small></div><div class="qty"><button data-minus="${id}">−</button><b>${q}</b><button data-plus="${id}">+</button></div><span class="line-total">${money(x.price*q)}</span></div>`}).join('')};const sub=rows.reduce((a,[id,q])=>a+menu.find(x=>x.id===id).price*q,0);const disc=Math.min(sub,Math.max(0,Number($('discount').value)||0));$('subtotal').textContent=money(sub);$('discountText').textContent='− '+money(disc);$('grandTotal').textContent=money(sub-disc)}
function renderHistory(){const b=getBills();$('historyList').innerHTML=b.length?b.slice(0,5).map(x=>`<div class="history-item"><span><b>${x.id}</b><br>${new Date(x.createdAt).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} · ${x.payment}</span><b>${money(x.total)}</b></div>`).join(''):'No bills created yet.';const today=new Date().toDateString();const daily=b.filter(x=>new Date(x.createdAt).toDateString()===today);$('billCount').textContent=daily.length;$('todaySales').textContent=money(daily.reduce((a,x)=>a+x.total,0))}
$('categories').addEventListener('click',e=>{const b=e.target.closest('[data-cat]');if(!b)return;category=b.dataset.cat;renderCategories();renderProducts()});$('products').addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(!b)return;const id=b.dataset.add;cart.set(id,(cart.get(id)||0)+1);renderCart()});$('cartItems').addEventListener('click',e=>{const p=e.target.dataset.plus,m=e.target.dataset.minus;if(p)cart.set(p,(cart.get(p)||0)+1);if(m){const n=(cart.get(m)||0)-1;if(n<1)cart.delete(m);else cart.set(m,n)}renderCart()});$('search').addEventListener('input',renderProducts);$('discount').addEventListener('input',renderCart);$('clearCart').onclick=()=>{cart.clear();renderCart()};$('refresh').onclick=renderHistory;
function printBill(bill){const rows=bill.items.map(x=>`<tr><td>${x.name}<br><small>${x.qty} × ${money(x.price)}</small></td><td style="text-align:right">${money(x.qty*x.price)}</td></tr>`).join('');const w=window.open('','_blank','width=380,height=650');if(!w){toast('Allow pop-ups to print the receipt');return}w.document.write(`<!doctype html><html><head><title>${bill.id}</title><style>body{font:13px Arial;padding:15px;color:#111}h2,p{text-align:center;margin:5px}hr{border:0;border-top:1px dashed #777;margin:12px 0}table{width:100%;border-collapse:collapse}td{padding:7px 0;vertical-align:top}.total{font-size:17px;font-weight:bold}small{color:#555}@media print{button{display:none}}</style></head><body><h2>ONE BITE</h2><p>Take a Bite. Feel the Happiness!</p><p>Kedgaon, Ahilyanagar</p><hr><p>Bill: ${bill.id}</p><p>${new Date(bill.createdAt).toLocaleString()}</p><p>Customer: ${bill.customer||'Walk-in'}</p><hr><table>${rows}</table><hr><p style="text-align:right">Subtotal: ${money(bill.subtotal)}</p><p style="text-align:right">Discount: − ${money(bill.discount)}</p><p class="total" style="text-align:right">TOTAL: ${money(bill.total)}</p><p>Payment: ${bill.payment}</p><hr><p>Thank you! Visit again.</p><script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close()}
$('complete').onclick=()=>{if(!cart.size){toast('Add at least one item first');return}const items=[...cart.entries()].map(([id,qty])=>{const x=menu.find(m=>m.id===id);return {id,name:x.name,price:x.price,qty}});const subtotal=items.reduce((a,x)=>a+x.price*x.qty,0);const discount=Math.min(subtotal,Math.max(0,Number($('discount').value)||0));const bill={id:'OB-'+Date.now().toString().slice(-8),customer:$('customer').value.trim(),items,subtotal,discount,total:subtotal-discount,payment:$('payment').value,createdAt:Date.now()};const bills=getBills();bills.unshift(bill);localStorage.setItem('onebite_pos_bills',JSON.stringify(bills));cart.clear();$('customer').value='';$('discount').value='0';renderCart();renderHistory();printBill(bill);toast('Bill saved on this device')};
$('today').textContent=new Date().toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short',year:'numeric'});renderCategories();renderProducts();renderCart();renderHistory();if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('/pos-sw.js').catch(err=>console.error('POS service worker',err)))}
</script></body></html>
